<div id="app" data-product-id="<%= productId %>">
  <div v-if="loading" class="flex justify-center py-24">
    <div class="size-8 animate-spin rounded-full border-4 border-ink border-t-transparent"></div>
  </div>

  <div v-else-if="notFound" class="container-page py-24 text-center">
    <h2 class="font-display text-3xl font-black text-ink">找不到此商品</h2>
    <a href="/" class="btn-primary mt-6 px-8 py-3.5 text-base">回到首頁</a>
  </div>

  <template v-else-if="product">
    <!-- Breadcrumb -->
    <nav class="container-page flex items-center gap-2.5 pt-6 text-sm md:pt-7" aria-label="breadcrumb">
      <a href="/" class="text-ink-soft transition-colors hover:text-ink">商品列表</a>
      <%- include('../partials/icon', { name: 'chevron-right', cls: 'size-3.5 text-ink-soft' }) %>
      <span class="font-medium text-ink">{{ product.name }}</span>
    </nav>

    <!-- Main -->
    <section class="container-page flex flex-col gap-10 pt-6 pb-16 md:pt-8 md:pb-24 lg:flex-row lg:gap-20">
      <div class="aspect-[640/780] w-full overflow-hidden rounded-[2px] bg-image-fallback lg:w-[640px] lg:shrink-0">
        <img
          :src="product.image_url || fallbackImage"
          :alt="product.name"
          class="size-full object-cover"
        />
      </div>

      <div class="flex flex-col gap-6 lg:flex-1 lg:gap-7 lg:pt-6">
        <h1 class="font-display text-4xl leading-tight font-black text-ink md:text-5xl lg:text-[52px]">{{ product.name }}</h1>

        <div><span class="price-tag price-tag-lg">NT$ {{ product.price.toLocaleString() }}</span></div>

        <div v-if="product.stock > 0" class="flex items-center gap-2 text-[15px] font-medium text-fern">
          <%- include('../partials/icon', { name: 'check', cls: 'size-[18px]' }) %>
          尚有 {{ product.stock }} 件現貨
        </div>
        <div v-else class="text-[15px] font-medium text-berry">目前已售完</div>

        <p class="text-base leading-[1.9] text-ink-soft lg:text-[17px]">{{ product.description }}</p>

        <!-- Quantity -->
        <div class="flex items-center gap-5">
          <span class="text-[15px] font-medium text-ink">數量</span>
          <div class="stepper">
            <button @click="decrease" :disabled="quantity <= 1" class="stepper-btn size-12 text-lg" aria-label="減少數量">−</button>
            <span class="flex h-12 w-14 items-center justify-center text-lg">{{ quantity }}</span>
            <button @click="increase" :disabled="quantity >= product.stock" class="stepper-btn size-12 text-lg" aria-label="增加數量">+</button>
          </div>
        </div>

        <button
          @click="addToCart"
          :disabled="adding || product.stock <= 0"
          class="btn-primary w-full py-[18px] text-[17px]"
        >
          <%- include('../partials/icon', { name: 'shopping-bag' }) %>
          {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
        </button>

        <!-- Purchase notes -->
        <div class="flex flex-col gap-2.5 border-l-4 border-saffron py-1 pl-5">
          <h3 class="font-display text-lg font-bold text-ink">購買須知</h3>
          <p class="text-sm text-ink-soft">花材依季節供應，實際花束可能略有差異</p>
          <p class="text-sm text-ink-soft">台北市區中午前下單，可選當日急件（+NT$ <%= shippingRates.URGENT_SURCHARGE %>）</p>
          <p class="text-sm text-ink-soft">宅配滿 NT$ <%= shippingRates.FREE_SHIPPING_THRESHOLD.toLocaleString('en-US') %> 免運費</p>
        </div>
      </div>
    </section>

    <!-- More products -->
    <section v-if="related.length > 0" class="bg-lilac">
      <div class="container-page flex flex-col gap-8 pt-14 pb-16 md:gap-10 md:pt-[72px] md:pb-24">
        <h2 class="font-display text-[28px] font-black text-ink md:text-4xl">也看看這些花</h2>
        <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-[55px]">
          <article
            v-for="item in related"
            :key="item.id"
            @click="goToProduct(item.id)"
            class="group flex cursor-pointer flex-col gap-4"
          >
            <div class="aspect-[390/360] overflow-hidden rounded-[2px] bg-image-fallback">
              <img
                :src="item.image_url || fallbackImage"
                :alt="item.name"
                class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <h3 class="font-display text-[22px] font-bold text-ink">{{ item.name }}</h3>
            <div class="flex items-center justify-between gap-3">
              <span class="price-tag">NT$ {{ item.price.toLocaleString() }}</span>
              <button
                @click.stop="addRelated(item)"
                :disabled="item.stock <= 0"
                class="btn-outline px-4 py-[9px] text-sm"
              >
                {{ item.stock <= 0 ? '已售完' : '加入購物車' }}
              </button>
            </div>
          </article>
        </div>
      </div>
    </section>
  </template>
</div>
