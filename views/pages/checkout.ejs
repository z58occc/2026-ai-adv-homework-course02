<div id="app" class="container-page flex flex-col gap-10 pt-10 pb-16 md:gap-12 md:pt-14 md:pb-24">
  <h1 class="font-display text-4xl font-black text-ink md:text-[52px]">結帳</h1>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="size-8 animate-spin rounded-full border-4 border-ink border-t-transparent"></div>
  </div>

  <div v-else class="flex flex-col gap-12 lg:flex-row lg:gap-24">
    <!-- Form -->
    <div class="flex flex-1 flex-col gap-9">
      <h2 class="font-display text-[26px] font-black text-ink">收件資訊</h2>

      <div class="flex flex-col gap-2.5">
        <label class="text-sm font-medium text-ink-soft">收件人姓名</label>
        <input
          v-model="form.recipientName"
          type="text"
          placeholder="請輸入收件人姓名"
          class="field-input"
          :class="{ 'is-error': errors.recipientName }"
        />
        <p v-if="errors.recipientName" class="text-xs text-berry">{{ errors.recipientName }}</p>
      </div>

      <div class="flex flex-col gap-2.5">
        <label class="text-sm font-medium text-ink-soft">Email</label>
        <input
          v-model="form.recipientEmail"
          type="email"
          placeholder="請輸入 Email"
          class="field-input"
          :class="{ 'is-error': errors.recipientEmail }"
        />
        <p v-if="errors.recipientEmail" class="text-xs text-berry">{{ errors.recipientEmail }}</p>
      </div>

      <div class="flex flex-col gap-2.5">
        <label class="text-sm font-medium text-ink-soft">{{ isCvsPickup ? '取貨門市地址' : '收件地址' }}</label>
        <input
          v-model="form.recipientAddress"
          type="text"
          :placeholder="isCvsPickup ? '請輸入取貨門市名稱與地址' : '請輸入收件地址'"
          class="field-input"
          :class="{ 'is-error': errors.recipientAddress }"
        />
        <p v-if="errors.recipientAddress" class="text-xs text-berry">{{ errors.recipientAddress }}</p>
      </div>

      <!-- Shipping options -->
      <div class="flex flex-col gap-5 pt-3">
        <h2 class="font-display text-[26px] font-black text-ink">配送方式</h2>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <label
            class="flex cursor-pointer items-start gap-3 rounded border-[1.5px] bg-white p-4 transition-colors"
            :class="form.shippingMethod === 'home_delivery' ? 'border-ink' : 'border-line hover:border-mist'"
          >
            <input v-model="form.shippingMethod" type="radio" name="shippingMethod" value="home_delivery" class="mt-1 size-4 shrink-0 accent-ink" />
            <span class="flex flex-col gap-1">
              <span class="font-medium text-ink">宅配到府</span>
              <span class="text-sm text-ink-soft">NT$ <%= shippingRates.HOME_DELIVERY_FEE %>・滿 NT$ <%= shippingRates.FREE_SHIPPING_THRESHOLD.toLocaleString('en-US') %> 免運</span>
            </span>
          </label>
          <label
            class="flex cursor-pointer items-start gap-3 rounded border-[1.5px] bg-white p-4 transition-colors"
            :class="form.shippingMethod === 'cvs_pickup' ? 'border-ink' : 'border-line hover:border-mist'"
          >
            <input v-model="form.shippingMethod" type="radio" name="shippingMethod" value="cvs_pickup" class="mt-1 size-4 shrink-0 accent-ink" />
            <span class="flex flex-col gap-1">
              <span class="font-medium text-ink">超商取貨</span>
              <span class="text-sm text-ink-soft">NT$ <%= shippingRates.CVS_PICKUP_FEE %>・不適用滿額免運</span>
            </span>
          </label>
        </div>

        <label
          class="flex cursor-pointer items-start gap-3 rounded border-[1.5px] bg-white p-4 transition-colors"
          :class="form.isUrgent ? 'border-ink' : 'border-line hover:border-mist'"
        >
          <input v-model="form.isUrgent" type="checkbox" class="mt-1 size-4 shrink-0 accent-ink" />
          <span class="flex flex-col gap-1">
            <span class="font-medium text-ink">當日急件 <span class="text-ink-soft">+NT$ <%= shippingRates.URGENT_SURCHARGE %></span></span>
            <span class="text-sm text-ink-soft">台北市區中午前下單，當日送達</span>
          </span>
        </label>

        <p class="text-sm text-ink-soft">
          離島地區（澎湖、金門、馬祖、綠島、蘭嶼、小琉球）依地址自動加收偏遠地區運費 NT$ <%= shippingRates.REMOTE_AREA_SURCHARGE %>。一般配送 2–3 天送達。
        </p>
      </div>
    </div>

    <!-- Summary -->
    <aside class="flex h-fit w-full flex-col gap-5 rounded border-[1.5px] border-ink bg-white p-6 sm:p-8 lg:w-[460px] lg:shrink-0">
      <h2 class="font-display text-2xl font-black text-ink">訂單摘要</h2>

      <div v-for="item in cartItems" :key="item.id" class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="font-medium text-ink">{{ item.product.name }}</span>
          <span class="shrink-0 text-sm text-ink-soft">× {{ item.quantity }}</span>
        </div>
        <span class="shrink-0 text-[15px] text-ink">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
      </div>

      <div class="flex justify-between border-t border-line pt-4 text-[15px]">
        <span class="text-ink-soft">商品小計</span>
        <span class="font-medium text-ink">NT$ {{ cartTotal.toLocaleString() }}</span>
      </div>

      <template v-if="quote">
        <div class="flex flex-col gap-1.5">
          <div class="flex justify-between text-[15px]">
            <span class="text-ink-soft">{{ quote.shipping_method === 'cvs_pickup' ? '超商取貨' : '宅配運費' }}</span>
            <span v-if="quote.is_free_shipping" class="font-medium text-fern">免運</span>
            <span v-else class="font-medium text-ink">NT$ {{ quote.delivery_fee.toLocaleString() }}</span>
          </div>
          <p
            v-if="quote.shipping_method === 'home_delivery' && !quote.is_free_shipping"
            class="text-xs text-ink-soft"
          >再買 NT$ {{ (quote.free_shipping_threshold - quote.subtotal).toLocaleString() }} 即享宅配免運</p>
        </div>
        <div v-if="quote.remote_area_fee > 0" class="flex justify-between text-[15px]">
          <span class="text-ink-soft">偏遠地區加收</span>
          <span class="font-medium text-ink">NT$ {{ quote.remote_area_fee.toLocaleString() }}</span>
        </div>
        <div v-if="quote.urgent_fee > 0" class="flex justify-between text-[15px]">
          <span class="text-ink-soft">當日急件加收</span>
          <span class="font-medium text-ink">NT$ {{ quote.urgent_fee.toLocaleString() }}</span>
        </div>
      </template>

      <div class="flex items-center justify-between border-t border-line pt-5">
        <span class="font-bold text-ink">總計</span>
        <span class="font-display text-[30px] font-black text-ink transition-opacity" :class="{ 'opacity-40': quoting }">
          {{ quote ? 'NT$ ' + quote.total_amount.toLocaleString() : '計算中…' }}
        </span>
      </div>
      <button @click="submitOrder" :disabled="submitting || quoting || !quote" class="btn-primary w-full py-[17px] text-[17px]">
        {{ submitting ? '處理中...' : '送出訂單' }}
      </button>
    </aside>
  </div>
</div>
