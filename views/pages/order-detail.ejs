<div id="app" data-order-id="<%= orderId %>" data-payment-result="<%= paymentResult %>" class="container-page flex flex-col gap-10 pt-10 pb-20 md:gap-12 md:pt-14 md:pb-[120px]">
  <div v-if="loading" class="flex justify-center py-12">
    <div class="size-8 animate-spin rounded-full border-4 border-ink border-t-transparent"></div>
  </div>

  <template v-else-if="order">
    <!-- Head -->
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-col gap-3.5">
        <h1 class="font-display text-4xl font-black text-ink md:text-[52px]">訂單詳情</h1>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="font-medium text-ink">{{ order.order_no }}</span>
          <span class="text-[15px] text-ink-soft">{{ new Date(order.created_at).toLocaleDateString('zh-TW') }} 下單</span>
          <span
            class="rounded-[3px] px-3.5 py-[5px] text-[13px] font-bold"
            :class="statusMap[order.status]?.cls || 'bg-line text-ink-soft'"
          >{{ statusMap[order.status]?.label || order.status }}</span>
        </div>
      </div>

      <div v-if="order.status === 'pending'" class="flex flex-wrap gap-3">
        <button @click="checkPayment" :disabled="paying" class="btn-outline px-6 py-4 text-base">
          {{ paying ? '查詢中...' : '查詢付款狀態' }}
        </button>
        <a :href="'/ecpay/payment/' + order.id" class="btn-primary px-8 py-4 text-base">
          <%- include('../partials/icon', { name: 'credit-card' }) %>
          前往付款
        </a>
      </div>
    </div>

    <!-- Payment result -->
    <div
      v-if="paymentResult && paymentMessages[paymentResult]"
      class="rounded px-[18px] py-3 text-[15px] font-medium"
      :class="paymentMessages[paymentResult].cls"
    >
      {{ paymentMessages[paymentResult].text }}
    </div>

    <div class="flex flex-col gap-12 lg:flex-row lg:gap-24">
      <!-- Items -->
      <div class="flex min-w-0 flex-1 flex-col">
        <h2 class="font-display text-[26px] font-black text-ink">商品明細</h2>
        <table class="mt-6 w-full">
          <thead>
            <tr class="border-b-[1.5px] border-ink text-sm font-bold text-ink-soft">
              <th class="pb-3 text-left font-bold">商品名稱</th>
              <th class="hidden w-[120px] pb-3 text-right font-bold sm:table-cell">單價</th>
              <th class="w-14 pb-3 text-right font-bold sm:w-20">數量</th>
              <th class="w-28 pb-3 text-right font-bold sm:w-[140px]">小計</th>
            </tr>
          </thead>
          <tbody>
            <tr v-for="item in order.items" :key="item.id" class="border-b border-line">
              <td class="py-5 pr-3 font-display text-base font-bold text-ink sm:py-[22px] sm:text-xl">{{ item.product_name }}</td>
              <td class="hidden py-[22px] text-right text-ink-soft sm:table-cell">NT$ {{ item.product_price.toLocaleString() }}</td>
              <td class="py-5 text-right text-ink sm:py-[22px]">{{ item.quantity }}</td>
              <td class="py-5 text-right font-display font-bold text-ink sm:py-[22px]">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</td>
            </tr>
          </tbody>
        </table>
        <div class="flex items-center justify-end gap-6 pt-6">
          <span class="font-bold text-ink">總計</span>
          <span class="font-display text-[28px] font-black text-ink md:text-[34px]">NT$ {{ order.total_amount.toLocaleString() }}</span>
        </div>
      </div>

      <!-- Recipient -->
      <aside class="flex h-fit w-full flex-col gap-5 border-l-4 border-saffron pl-6 lg:w-[420px] lg:shrink-0 lg:pl-7">
        <h2 class="font-display text-[26px] font-black text-ink">收件資訊</h2>
        <div class="flex flex-col gap-1.5">
          <span class="text-sm text-ink-soft">收件人</span>
          <span class="text-[17px] font-medium break-words text-ink">{{ order.recipient_name }}</span>
        </div>
        <div class="flex flex-col gap-1.5">
          <span class="text-sm text-ink-soft">Email</span>
          <span class="text-[17px] font-medium break-all text-ink">{{ order.recipient_email }}</span>
        </div>
        <div class="flex flex-col gap-1.5">
          <span class="text-sm text-ink-soft">地址</span>
          <span class="text-[17px] font-medium break-words text-ink">{{ order.recipient_address }}</span>
        </div>
      </aside>
    </div>
  </template>
</div>
