<div id="app" class="container-page flex flex-col gap-8 pt-10 pb-16 md:gap-10 md:pt-14 md:pb-24">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <h1 class="font-display text-4xl font-black text-ink md:text-[52px]">購物車</h1>

    <template v-if="!loading && items.length > 0">
      <div v-if="total >= 500" class="flex items-center gap-2.5 self-start rounded bg-fern-bg px-[18px] py-2.5 text-[15px] font-medium text-fern sm:self-auto">
        <%- include('../partials/icon', { name: 'check', cls: 'size-[18px]' }) %>
        已達免運門檻
      </div>
      <div v-else class="self-start rounded bg-saffron-bg px-[18px] py-2.5 text-[15px] font-medium text-saffron-ink sm:self-auto">
        再買 NT$ {{ (500 - total).toLocaleString() }} 即可享免運費
      </div>
    </template>
  </div>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="size-8 animate-spin rounded-full border-4 border-ink border-t-transparent"></div>
  </div>

  <div v-else-if="items.length === 0" class="border-y border-line py-16 text-center">
    <p class="font-display text-2xl font-bold text-ink">購物車是空的</p>
    <p class="mt-2 mb-6 text-sm text-ink-soft">快去挑選喜歡的花束吧</p>
    <a href="/" class="btn-primary px-8 py-3.5 text-base">去逛逛</a>
  </div>

  <div v-else class="flex flex-col gap-10 lg:flex-row lg:gap-[72px]">
    <!-- Items -->
    <div class="flex flex-1 flex-col border-t border-line">
      <div
        v-for="item in items"
        :key="item.id"
        class="flex flex-wrap items-center gap-x-4 gap-y-4 border-b border-line py-6 sm:flex-nowrap sm:gap-6 sm:py-7"
      >
        <img
          :src="item.product.image_url || fallbackImage"
          :alt="item.product.name"
          class="size-20 shrink-0 rounded-[2px] bg-image-fallback object-cover sm:size-28"
        />
        <div class="flex min-w-0 flex-1 flex-col gap-2">
          <h3 class="font-display text-lg font-bold text-ink sm:text-[22px]">{{ item.product.name }}</h3>
          <p class="text-[15px] text-ink-soft">NT$ {{ item.product.price.toLocaleString() }}</p>
        </div>

        <div class="flex w-full items-center justify-between gap-4 sm:w-auto sm:justify-start sm:gap-6">
          <div class="stepper">
            <button
              @click="updateQuantity(item.id, item.quantity - 1)"
              :disabled="item.quantity <= 1"
              class="stepper-btn size-10 text-base"
              aria-label="減少數量"
            >−</button>
            <span class="flex h-10 w-11 items-center justify-center text-base">{{ item.quantity }}</span>
            <button
              @click="updateQuantity(item.id, item.quantity + 1)"
              :disabled="item.quantity >= item.product.stock"
              class="stepper-btn size-10 text-base"
              aria-label="增加數量"
            >+</button>
          </div>

          <p class="font-display text-lg font-black text-ink sm:w-[120px] sm:text-right sm:text-xl">
            NT$ {{ (item.product.price * item.quantity).toLocaleString() }}
          </p>

          <button
            @click="confirmDelete(item.id)"
            class="text-ink-soft transition-colors hover:text-berry"
            aria-label="移除商品"
          >
            <%- include('../partials/icon', { name: 'trash-2' }) %>
          </button>
        </div>
      </div>
    </div>

    <!-- Summary -->
    <aside class="flex h-fit w-full flex-col gap-5 rounded border-[1.5px] border-ink bg-white p-6 sm:p-8 lg:w-[400px] lg:shrink-0">
      <h2 class="font-display text-2xl font-black text-ink">訂單摘要</h2>
      <div class="flex justify-between text-[15px]">
        <span class="text-ink-soft">商品小計</span>
        <span class="font-medium text-ink">NT$ {{ total.toLocaleString() }}</span>
      </div>
      <div class="flex justify-between text-[15px]">
        <span class="text-ink-soft">運費</span>
        <span class="font-medium" :class="total >= 500 ? 'text-fern' : 'text-ink'">{{ total >= 500 ? '免運' : 'NT$ 150' }}</span>
      </div>
      <div class="flex items-center justify-between border-t border-line pt-5">
        <span class="font-bold text-ink">總計</span>
        <span class="font-display text-[30px] font-black text-ink">
          NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}
        </span>
      </div>
      <button @click="goCheckout" class="btn-primary w-full py-[17px] text-[17px]">前往結帳</button>
    </aside>
  </div>

  <!-- Confirm dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-[60] flex items-center justify-center">
    <div class="absolute inset-0 bg-ink/50" @click="confirmVisible = false"></div>
    <div class="relative mx-4 w-full max-w-sm rounded border-[1.5px] border-ink bg-white p-8 text-center">
      <h3 class="font-display text-xl font-black text-ink">確認移除</h3>
      <p class="mt-2 mb-6 text-sm text-ink-soft">確定要從購物車中移除這個商品嗎？</p>
      <div class="flex justify-center gap-3">
        <button @click="confirmVisible = false" class="btn-outline px-5 py-2.5 text-sm">取消</button>
        <button @click="handleDelete" class="inline-flex items-center justify-center rounded bg-berry px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90">確認移除</button>
      </div>
    </div>
  </div>
</div>
