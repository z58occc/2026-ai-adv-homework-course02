# Dependencies
node_modules/

# Build output (Tailwind, generated by npm run css:build)
public/css/output.css

# SQLite database files (tests use an in-memory DB; E2E writes to the dev DB)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Environment files
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Playwright (npm run test:e2e)
playwright-report/
test-results/
blob-report/
playwright/.cache/
# E2E screenshots, overwritten on every run (npm run test:e2e)
tests/e2e/screenshots/
# Playwright MCP browser artifacts
.playwright-mcp/

# Generated Postman collection (npm run postman)
postman/

# Temp files
*.tmp
*.swp

# Claude Code local settings
.claude/*.local.json
# Third-party skill cloned with its own .git (nested repo, not part of this project)
.claude/skills/claude-claw-init/

# Local notes
qa.md
